# Токен Telegram-бота от @BotFather
BOT_TOKEN=1234567890:PASTE_YOUR_TOKEN_HERE

# Ваш цифровой Telegram ID. Можно сначала оставить пустым,
# запустить бота и отправить /start — бот покажет ID.
TELEGRAM_USER_ID=

RSS_URL=https://www.fl.ru/rss/?category=5
CHECK_INTERVAL_SECONDS=120
